# ============================================================
# Synapse 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改
# ============================================================

# ---------- Redis 配置 ----------
REDIS_URL=redis://redis:6379/0
# 后端选择: auto（连不上自动退化为进程内内存实现，重启即丢，适合单机开发）
#          server（必须连真实服务，多 worker 部署用）/ memory（强制内存）
REDIS_MODE=auto
REDIS_CONNECT_TIMEOUT=3

# ---------- ChromaDB 配置 ----------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 后端选择: auto（服务不可用时退化为内嵌持久化，数据落在 DATA_DIR/chroma）
#          server（必须连真实服务，多 worker 部署用）/ embedded（直接用本地文件）
CHROMA_MODE=auto

# ChromaDB 集合名
CHROMA_COLLECTION_INTENTS=intent_examples
CHROMA_COLLECTION_SUMMARY=session_summaries
CHROMA_COLLECTION_KNOWLEDGE=knowledge_base
CHROMA_COLLECTION_PROFILE=user_profiles

# ---------- LLM 配置 ----------
# 提供商: openai / claude / deepseek
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
# 兼容 OpenAI 协议的 base_url（自建服务或代理时可修改）
LLM_BASE_URL=https://api.openai.com/v1
# Claude 专用配置
CLAUDE_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DeepSeek 专用配置（兼容 OpenAI 协议，LLM_PROVIDER=deepseek 时生效）
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Embedding 模型与专用配置（DeepSeek 不支持 embedding；LLM_PROVIDER=deepseek 时
# 需将下面两项指向支持 embedding 的服务如 OpenAI 并填对应 key；留空回退 LLM_* 可能 401）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# Embedding 提供方：openai（OpenAI 兼容接口）/ local（ChromaDB 内置本地模型，无需 API Key）
# 【DeepSeek 用户必读】DeepSeek 不提供 embedding 接口，保持 openai 会因 key 不匹配
# 而每轮报 401；把下面一行改成 local 即可，首次使用会下载约 80MB 本地模型。
# 注意：切换后向量维度会变化，已有知识库需调用 POST /knowledge-bases/{id}/reindex 重建
EMBEDDING_PROVIDER=local
# 请求超时（秒）
LLM_TIMEOUT=60

# ---------- 数据与数据库 ----------
# 本地数据目录：SQLite、上传文件、仓库 clone、应用密钥
DATA_DIR=data
# 留空使用 DATA_DIR 下的 SQLite；企业部署可用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://synapse:synapse@postgres:5432/synapse
DATABASE_URL=

# ---------- 鉴权与安全 ----------
# 个人部署可关闭（所有请求视为本地管理员）；企业部署务必开启
AUTH_ENABLED=false
# 应用密钥（JWT 签名、仓库令牌加密）；留空自动生成并保存到 DATA_DIR/.secret_key
APP_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440
# 初始管理员；密码留空则首次启动随机生成并打印到日志，设置后重启会重置为该密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- 知识库（RAG） ----------
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
UPLOAD_MAX_MB=20

# ---------- 网页抓取 ----------
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=2097152
# 是否允许抓取内网地址（默认禁止，防 SSRF）
WEB_ALLOW_PRIVATE=false

# ---------- 代码仓库助手 ----------
# 全局写操作开关（建 Issue、评论）；还需管理员为仓库连接开启 allow_write，且每次执行需用户确认
REPO_WRITE_ENABLED=false
REPO_INDEX_MAX_FILES=300
REPO_INDEX_MAX_FILE_KB=200

# ---------- 定时任务 ----------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# ---------- 插件 ----------
PLUGINS_DIR=plugins
MCP_ENABLED=true

# ---------- 应用层（CORS / 文档） ----------
# CORS 允许来源，逗号分隔；* 表示全部（此时自动禁用凭证）
CORS_ORIGINS=*
# 是否开启 /docs /redoc API 文档（生产建议 false）
DOCS_ENABLED=true

# ---------- 意图识别三路融合权重 ----------
INTENT_LLM_WEIGHT=0.5
INTENT_VECTOR_WEIGHT=0.3
INTENT_KEYWORD_WEIGHT=0.2

# ---------- 记忆管理 ----------
# 短期记忆最大轮数
SHORT_TERM_MAX_ROUNDS=10
# 短期记忆 TTL（秒），默认 24 小时
SHORT_TERM_TTL=86400
# 触发摘要压缩的轮数阈值
SUMMARY_TRIGGER_ROUNDS=8
# 长期记忆召回 Top-K
LONG_TERM_RECALL_K=3
# 单次 Token 估算上限（超出也触发压缩）
TOKEN_BUDGET=4000

# ---------- 路由与故障恢复 ----------
# Agent 健康分低于此阈值时从路由池摘除
AGENT_HEALTH_THRESHOLD=0.3
# 异常时权重衰减因子（乘以此值）
WEIGHT_DECAY_FACTOR=0.5
# 恢复时权重回调因子
WEIGHT_RECOVERY_FACTOR=1.1
# 请求超时（秒），用于降级判断
AGENT_TIMEOUT=30

# ---------- Z-score 异常检测 ----------
# 滑动窗口大小（最近 N 次请求）
ZSCORE_WINDOW_SIZE=20
# Z-score 异常阈值（当前耗时 > μ + Z*σ 即异常）
ZSCORE_THRESHOLD=3.0
# 异常检测后台任务间隔（秒）
ANOMALY_CHECK_INTERVAL=10
